---
// Built cases render the full study; the rest keep the placeholder page.
import CaseView from '../../views/CaseView.astro';
import CaseStubView from '../../views/CaseStubView.astro';
import { caseProjects, type Project } from '../../content/projects';
import { cases } from '../../content/cases';

export function getStaticPaths() {
  return caseProjects.map((project) => ({ params: { slug: project.slug }, props: { project } }));
}
const { project } = Astro.props as { project: Project };
const study = project.state === 'open' ? cases[project.slug] : undefined;
---
{study ? <CaseView locale="en" project={project} study={study} /> : <CaseStubView locale="en" project={project} />}
