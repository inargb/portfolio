---
// Paper ↔ darkroom. A pull-cord: the cord tugs when pressed, and in the
// darkroom the bulb becomes the red safelight.
import type { Locale } from '../i18n/config';
import { ui } from '../i18n/ui';

interface Props { locale: Locale; }
const { locale } = Astro.props;
const c = ui.controls;
---

<button
  class="lights"
  type="button"
  aria-pressed="false"
  data-lights
  data-label-off={c.lightsOff[locale]}
  data-label-on={c.lightsOn[locale]}
  data-cursor="link"
>
  <svg class="lights__icon" viewBox="0 0 24 32" aria-hidden="true">
    <line class="lights__cord" x1="12" y1="0" x2="12" y2="18" />
    <circle class="lights__bulb" cx="12" cy="23" r="5" />
  </svg>
  <span class="visually-hidden" data-lights-label>{c.lightsOff[locale]} ({c.lightsHint[locale]})</span>
</button>

<style>
  .lights {
    display: inline-grid;
    place-items: start center;
    width: var(--tap-min);
    height: var(--tap-min);
    padding: 0;
    border: 0;
    background: none;
    color: var(--color-ink);
  }
  .lights__icon { width: 1.1rem; overflow: visible; }
  .lights__cord { stroke: currentColor; stroke-width: 1; }
  .lights__bulb {
    fill: var(--color-paper);
    stroke: currentColor;
    stroke-width: 1.25;
    transition: fill var(--duration-slow) var(--ease-soft);
  }
  .lights:hover .lights__icon,
  .lights:focus-visible .lights__icon { translate: 0 2px; transition: translate var(--duration-quick) var(--ease-soft); }
  .lights.is-tugged .lights__icon { animation: tug var(--duration-slow) var(--ease-settle); }
  @keyframes tug { 30% { translate: 0 6px; } 60% { translate: 0 -1px; } }

  .lights[aria-pressed='true'] .lights__bulb {
    fill: var(--color-redline);
    stroke: var(--color-redline);
    filter: drop-shadow(0 0 4px var(--color-redline));
  }
</style>
