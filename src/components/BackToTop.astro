---
// Back to top: a keycap in the bottom-right corner. It shows up once the
// reader is well into a page (past ~1.2 screens) and hides near the top.
import type { Locale } from '../i18n/config';
import { ui } from '../i18n/ui';

interface Props { locale: Locale; }
const { locale } = Astro.props;
---

<button class="to-top keycap" type="button" aria-label={ui.toTop[locale]} data-to-top data-cursor="link" data-cursor-label={ui.toTopCursor[locale]} tabindex="-1" aria-hidden="true">
  <span aria-hidden="true">↑</span>
</button>

<style>
  .to-top {
    position: fixed;
    right: var(--layout-gutter);
    /* Rides above the footer once it scrolls in, never over its keys. */
    bottom: calc(var(--space-6) + env(safe-area-inset-bottom) + var(--to-top-lift, 0px));
    z-index: 30;
    width: 2.75rem;
    height: 2.75rem;
    font-size: 1rem;
    opacity: 0;
    translate: 0 0.75rem;
    pointer-events: none;
    transition: opacity var(--duration-settle) var(--ease-soft), translate var(--duration-settle) var(--ease-settle), box-shadow 120ms var(--ease-soft);
  }
  .to-top.is-on { opacity: 1; translate: 0 0; pointer-events: auto; }
  /* Pressed like a key. */
  .to-top:hover { box-shadow: 0 3px 0 var(--color-ink); translate: 0 -1px; }
  .to-top:active { box-shadow: 0 0 0 var(--color-ink); translate: 0 2px; }
  @media (prefers-reduced-motion: reduce) { .to-top { transition: opacity 120ms linear; translate: none; } }
</style>

<script>
  import { motionOn } from '../scripts/prefs';

  const btn = document.querySelector<HTMLButtonElement>('[data-to-top]');
  if (btn) {
    let on = false;
    const footer = document.querySelector<HTMLElement>('.footer');
    const update = () => {
      const lift = footer ? Math.max(0, innerHeight - footer.getBoundingClientRect().top) : 0;
      btn.style.setProperty('--to-top-lift', `${lift}px`);
      const next = scrollY > innerHeight * 1.2;
      if (next === on) return;
      on = next;
      btn.classList.toggle('is-on', on);
      btn.tabIndex = on ? 0 : -1;
      btn.setAttribute('aria-hidden', String(!on));
    };
    addEventListener('scroll', update, { passive: true });
    addEventListener('resize', update);
    update();

    btn.addEventListener('click', () => {
      scrollTo({ top: 0, behavior: motionOn() ? 'smooth' : 'auto' });
      // Keyboard users land back at the start of the page, not on a vanished button.
      document.querySelector<HTMLElement>('#main')?.focus({ preventScroll: true });
    });
  }
</script>
