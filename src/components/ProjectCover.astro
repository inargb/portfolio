---
// A project's cover. Uploaded media (video/gif + poster) wins when present;
// otherwise the hand-built CSS cover is used. Either way:
//   · 4:3, plays only while on screen
//   · with reduced motion (OS or the site's pause), only the still frame shows
import type { CoverId, CoverMedia } from '../content/projects';
import type { Locale } from '../i18n/config';
import { withBase } from '../i18n/config';
import CoverSpecs from './covers/CoverSpecs.astro';
import CoverMenu from './covers/CoverMenu.astro';
import CoverBarTabs from './covers/CoverBarTabs.astro';
import CoverPortal from './covers/CoverPortal.astro';
import CoverBandoneon from './covers/CoverBandoneon.astro';
import CoverBinder from './covers/CoverBinder.astro';
import CoverSabi from './covers/CoverSabi.astro';

interface Props { cover: CoverId; label: string; media?: CoverMedia; locale?: Locale; }
const { cover, label, media, locale = 'en' } = Astro.props;
const map = {
  specs: CoverSpecs,
  menu: CoverMenu,
  bartabs: CoverBarTabs,
  portal: CoverPortal,
  bandoneon: CoverBandoneon,
  binder: CoverBinder,
  sabi: CoverSabi,
} as const;
const Cover = map[cover];
// An empty label means the title sits next to the cover: the media is decorative.
const alt = label ? media?.alt[locale] ?? label : '';
const isGif = media?.type === 'image/gif' || media?.src.endsWith('.gif');
---

{media ? (
  <div class="media-cover" data-cover data-media-cover>
    {isGif ? (
      <img src={withBase(media.poster)} data-gif={withBase(media.src)} data-poster={withBase(media.poster)} alt={alt} loading="lazy" decoding="async" />
    ) : (
      <video muted loop playsinline preload="none" poster={withBase(media.poster)} aria-label={alt || undefined} aria-hidden={alt ? undefined : 'true'}>
        <source src={withBase(media.src)} type={media.type ?? 'video/mp4'} />
      </video>
    )}
  </div>
) : (
  <Cover label={label} />
)}

<style>
  .media-cover { aspect-ratio: 4 / 3; overflow: hidden; background: var(--color-paper-shade); }
  .media-cover :is(video, img) { width: 100%; height: 100%; object-fit: cover; }
</style>

<script>
  import { motionOn } from '../scripts/prefs';

  // Covers animate only while visible, and only with motion on.
  const covers = document.querySelectorAll<HTMLElement>('[data-cover]');
  const visible = new Set<HTMLElement>();

  function sync(el: HTMLElement) {
    const play = visible.has(el) && motionOn();
    el.toggleAttribute('data-inview', visible.has(el));
    const video = el.querySelector('video');
    if (video) { if (play) video.play().catch(() => {}); else video.pause(); }
    const gif = el.querySelector<HTMLImageElement>('img[data-gif]');
    if (gif) gif.src = play ? gif.dataset.gif! : gif.dataset.poster!;
  }

  if ('IntersectionObserver' in window) {
    const io = new IntersectionObserver((entries) => {
      for (const e of entries) {
        const el = e.target as HTMLElement;
        if (e.isIntersecting) visible.add(el); else visible.delete(el);
        sync(el);
      }
    }, { threshold: 0.25 });
    covers.forEach((c) => io.observe(c));
  }
  window.addEventListener('ina:prefs', () => covers.forEach(sync));
</script>
