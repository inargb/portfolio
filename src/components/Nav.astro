---
import LanguageSwitch from './LanguageSwitch.astro';
import LightsToggle from './LightsToggle.astro';
import { href, type Locale, type RouteId } from '../i18n/config';
import { ui } from '../i18n/ui';
import { site } from '../content/site';

interface Props { locale: Locale; route?: RouteId; altHref: string; }
const { locale, route, altHref } = Astro.props;
const n = ui.nav;
const homeHref = href('home', locale);
const links = [
  { id: 'work', label: n.work[locale], href: `${homeHref}${homeHref.endsWith('/') ? '' : '/'}#work`, current: false },
  { id: 'about', label: n.about[locale], href: href('about', locale), current: route === 'about' },
];
---

<header class="nav" data-spec-label="nav · 56px">
  <div class="nav__inner container">
    <a class="nav__mark t-nav" href={homeHref} aria-label={n.home[locale]} data-cursor="link">
      <span aria-hidden="true">inaiá silva<span class="caret"></span></span>
    </a>

    <nav class="nav__links" aria-label={n.label[locale]}>
      <ul role="list">
        {links.map((l) => (
          <li>
            <a class="nav__link t-nav" href={l.href} aria-current={l.current ? 'page' : undefined} data-cursor="link">
              {l.label}
            </a>
          </li>
        ))}
        <li>
          <a class="nav__link t-nav" href={site.links.resume[locale]} target="_blank" rel="noopener" data-cursor="link">
            {n.resume[locale]}<span aria-hidden="true"> ↗</span>
            <span class="visually-hidden">{n.newTab[locale]}</span>
          </a>
        </li>
      </ul>
    </nav>

    <div class="nav__tools">
      <LanguageSwitch locale={locale} altHref={altHref} />
      <LightsToggle locale={locale} />
    </div>
  </div>
</header>

<style>
  .nav {
    position: sticky;
    top: 0;
    z-index: 40;
    background: color-mix(in srgb, var(--color-paper) 92%, transparent);
    backdrop-filter: blur(6px);
    border-bottom: var(--rule-hair);
    transition: background-color var(--duration-slow) var(--ease-soft);
  }
  .nav__inner {
    display: flex;
    align-items: center;
    gap: var(--space-6);
    min-height: var(--nav-height);
  }
  .nav__mark {
    display: inline-flex;
    align-items: center;
    min-height: var(--tap-min);
    margin-right: auto;
    color: var(--color-ink);
    text-decoration: none;
    font-weight: 500;
  }
  .nav__links ul { display: flex; gap: var(--space-1); }
  .nav__link {
    position: relative;
    display: inline-flex;
    align-items: center;
    min-height: var(--tap-min);
    padding-inline: var(--space-3);
    color: var(--color-graphite);
    text-decoration: none;
    transition: color var(--duration-quick) var(--ease-soft);
  }
  /* A crop mark appears under the hovered / current link. */
  .nav__link::after {
    content: '';
    position: absolute;
    left: var(--space-3);
    right: var(--space-3);
    bottom: 0.7rem;
    height: 1px;
    background: currentColor;
    scale: 0 1;
    transform-origin: left;
    transition: scale var(--duration-settle) var(--ease-settle);
  }
  .nav__link:hover, .nav__link[aria-current='page'] { color: var(--color-ink); }
  .nav__link:hover::after, .nav__link[aria-current='page']::after { scale: 1 1; }
  .nav__tools { display: flex; align-items: center; gap: var(--space-2); }

  /* Phones: links move to a bottom bar within thumb reach. */
  @media (max-width: 40rem) {
    /* backdrop-filter would trap the fixed bottom bar inside the header. */
    .nav { backdrop-filter: none; background: var(--color-paper); }
    .nav__inner { gap: var(--space-2); }
    .nav__links {
      position: fixed;
      inset: auto 0 0 0;
      z-index: 45;
      background: var(--color-paper);
      border-top: var(--rule-ink);
      padding-bottom: env(safe-area-inset-bottom);
    }
    .nav__links ul { justify-content: space-around; }
    .nav__link { min-height: 3.25rem; }
    .nav__link::after { bottom: 0.9rem; }
  }
</style>
