---
// Renders one section's blocks. Every block type in content/cases/types.ts
// has a branch here, so cases are content only.
import CaseFigure from './CaseFigure.astro';
import type { Locale } from '../../i18n/config';
import { ui } from '../../i18n/ui';
import type { CaseBlock } from '../../content/cases/types';

interface Props { blocks: CaseBlock[]; locale: Locale; figStart: number; }
const { blocks, locale, figStart } = Astro.props;
// Figure numbers run through the whole case.
let fig = figStart;
const numbered = blocks.map((b) => {
  const first = fig;
  if (b.type === 'figure') fig += 1;
  if (b.type === 'gallery') fig += b.images.length;
  return { b, first };
});
const two = (i: number) => String(i + 1).padStart(2, '0');
// Cards sit like notes on a table: each a hair off straight.
const tilt = (i: number) => [-1.1, 0.5, -0.4, 0.9][i % 4];
// Line icons, 24×24, stroke = currentColor.
const icons: Record<string, string> = {
  layout: '<rect x="3.5" y="3.5" width="17" height="7" rx="2"/><rect x="3.5" y="13.5" width="7.5" height="7" rx="2"/><rect x="13" y="13.5" width="7.5" height="7" rx="2"/>',
  search: '<circle cx="10.5" cy="10.5" r="6.5"/><path d="M15.5 15.5 20.5 20.5"/>',
  star: '<path d="M12 3.5l2.6 5.3 5.9.9-4.3 4.1 1 5.8L12 16.9l-5.2 2.7 1-5.8-4.3-4.1 5.9-.9z"/>',
};
---

{numbered.map(({ b, first }) => {
  switch (b.type) {
    case 'text':
      return <div class="cb-text">{b.body.map((p) => <p class="t-body">{p[locale]}</p>)}</div>;

    case 'stats':
      return (
        <ul class="cb-cards cb-cards--3" role="list">
          {b.items.map((s, i) => (
            <li class="cb-card cb-card--stat paper-card lift" style={`--tilt:${tilt(i + 2)}deg`} data-reveal>
              <span class="cb-card__no t-heading-xl">{s.value[locale]}</span>
              <span class="cb-card__body">{s.label[locale]}</span>
            </li>
          ))}
        </ul>
      );

    case 'question':
      return (
        <div class="cb-question crop" data-reveal>
          <p class="t-label cb-question__label">{ui.case.question[locale]}</p>
          <p class="t-heading-s cb-question__text">{b.text[locale]}</p>
        </div>
      );

    case 'figure':
      return <CaseFigure image={b.image} caption={b.caption} locale={locale} n={first} />;

    case 'gallery':
      return (
        <figure class="cb-gallery">
          <ul class="cb-gallery__row" role="list">
            {b.images.map((img, i) => (
              <li><CaseFigure image={img} locale={locale} n={first + i} bare sizes="(max-width: 40rem) 100vw, 20rem" /></li>
            ))}
          </ul>
          <figcaption class="t-caption cb-gallery__cap">
            <span class="cb-gallery__no">{ui.case.fig[locale]} {String(first).padStart(2, '0')}–{String(first + b.images.length - 1).padStart(2, '0')}</span>
            {b.caption && <span> · {b.caption[locale]}</span>}
          </figcaption>
        </figure>
      );

    case 'steps':
      return (
        <ol class="cb-cards cb-cards--4" role="list">
          {b.items.map((s, i) => (
            <li class="cb-card paper-card lift" style={`--tilt:${tilt(i)}deg`} data-reveal>
              <span class="cb-card__no t-heading-xl" aria-hidden="true">{two(i)}</span>
              <h3 class="cb-card__title cb-card__title--sans"><span class="visually-hidden">{two(i)}. </span>{s.title[locale]}</h3>
              <p class="cb-card__body">{s.body[locale]}</p>
            </li>
          ))}
        </ol>
      );

    case 'decisions':
      return (
        <div class="cb-decisions">
          {b.intro && <p class="t-body">{b.intro[locale]}</p>}
          <ul class="cb-cards cb-cards--3" role="list">
            {b.items.map((d, i) => (
              <li class="cb-card paper-card lift" style={`--tilt:${tilt(i + 1)}deg`} data-reveal>
                <svg class="cb-card__icon" viewBox="0 0 24 24" aria-hidden="true" set:html={icons[d.icon]} />
                <h3 class="cb-card__title t-heading-m">{d.title[locale]}</h3>
                <p class="cb-card__body">
                  {d.body[locale]}{d.note && <span class="cb-card__note"> {d.note[locale]}</span>}
                </p>
                <p class="cb-card__tag">{d.tag[locale]}</p>
              </li>
            ))}
          </ul>
        </div>
      );
  }
})}

<style>
  .cb-text { display: grid; gap: var(--space-4); max-width: var(--layout-text); }
  .cb-text p { text-wrap: pretty; }

  .cb-question {
    display: grid;
    gap: var(--space-3);
    max-width: 48rem;
    padding: var(--space-8);
    background: var(--color-paper-shade);
  }
  .cb-question__label { color: var(--color-accent); }
  .cb-question__text { color: var(--color-ink); text-wrap: pretty; }

  /* Cards: paper notes with a double frame, each a hair off straight. */
  .cb-cards { display: grid; gap: var(--space-6); padding: var(--space-2); }
  .cb-cards--4 { grid-template-columns: repeat(4, minmax(0, 1fr)); }
  .cb-cards--3 { grid-template-columns: repeat(3, minmax(0, 1fr)); }
  /* The surface (paper, double frame, tilt) is .paper-card in components.css. */
  .cb-card {
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
    min-height: 22rem;
    padding: var(--space-8) var(--space-6);
  }
  .cb-card--stat { min-height: 0; gap: var(--space-2); }
  .cb-card__no { color: var(--color-ink); margin-bottom: var(--space-2); }
  .cb-card__icon { width: 2rem; height: 2rem; fill: none; stroke: var(--color-ink); stroke-width: 1.5; stroke-linejoin: round; stroke-linecap: round; margin-bottom: var(--space-2); }
  .cb-card__title { color: var(--color-ink); text-wrap: balance; }
  .cb-card__title--sans { font-family: var(--font-body); font-size: var(--type-heading-s); font-weight: 500; letter-spacing: -0.01em; line-height: 1.25; }
  .cb-card__body { font-size: var(--type-body-s); line-height: var(--leading-body); color: var(--color-graphite); text-wrap: pretty; }
  .cb-card__note { color: var(--color-graphite-soft); }
  .cb-card__tag { margin-top: var(--space-1); font-size: var(--type-meta); letter-spacing: 0.06em; text-transform: uppercase; color: var(--color-graphite-soft); }

  .cb-decisions { display: grid; gap: var(--space-8); }

  .cb-gallery { display: grid; gap: var(--space-3); margin: 0; }
  .cb-gallery__row { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: var(--space-4); }
  .cb-gallery__no { font-family: var(--font-system); text-transform: uppercase; letter-spacing: 0.08em; color: var(--color-ink); }

  @media (max-width: 64rem) {
    .cb-cards--4, .cb-cards--3 { grid-template-columns: repeat(2, minmax(0, 1fr)); }
    .cb-card { min-height: 0; }
  }
  @media (max-width: 40rem) {
    .cb-cards--4, .cb-cards--3, .cb-gallery__row { grid-template-columns: 1fr; }
    .cb-cards { gap: var(--space-8); padding-inline: var(--space-2); }
    .cb-question { padding: var(--space-6); }
  }
</style>
